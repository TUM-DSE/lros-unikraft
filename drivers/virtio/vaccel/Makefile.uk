$(eval $(call addlib_s,libvirtio_accel,$(CONFIG_LIBVIRTIO_ACCEL)))

LIBVIRTIO_ACCEL_CINCLUDES-y  += -I$(LIBVIRTIO_ACCEL_BASE)/include

# common virtio headers
LIBVIRTIO_ACCEL_CINCLUDES-y  += -I$(LIBVIRTIO_BUS_BASE)/include
LIBVIRTIO_ACCEL_CINCLUDES-y  += -I$(LIBVIRTIO_RING_BASE)/include
LIBVIRTIO_ACCEL_CINCLUDES-y  += -I$(UK_DRIV_LIBVIRTIO_BASE)/include

# TODO Remove as soon as plat dependencies go away
LIBVIRTIO_ACCEL_CINCLUDES-y  += -I$(UK_PLAT_COMMON_BASE)/include

LIBVIRTIO_ACCEL_SRCS-y += $(LIBVIRTIO_ACCEL_BASE)/accel.c
LIBVIRTIO_ACCEL_SRCS-y += $(LIBVIRTIO_ACCEL_BASE)/virtio_accel-core.c
LIBVIRTIO_ACCEL_SRCS-y += $(LIBVIRTIO_ACCEL_BASE)/virtio_accel-reqs.c
